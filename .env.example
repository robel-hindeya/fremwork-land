# Fremwork: every environment variable the code reads, grouped by where it is set.
# This file is documentation only. Copy the relevant block into apps/web/.env.local or apps/api/.env
# for local work. Never commit real values: .env, .env.local and apps/*/.env are git-ignored.

# ─── 1. Website (Vercel project, Root Directory: apps/web) ──────────────────────────────
# NEXT_PUBLIC_* values are public and baked in at build time: redeploy after changing them.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…) or the legacy anon key.
# Public by design; RLS protects the data. NEVER put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy name for the same public key (used only if the one above is empty).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This website's public URL, no trailing slash (auth email and OAuth redirects). e.g. https://fremwork.com
NEXT_PUBLIC_SITE_URL=
# URL of the deployed NestJS API (section 2), no trailing slash. Needed for invites and admin email.
# If empty, the site reads/writes Supabase directly through RLS-protected functions.
NEXT_PUBLIC_API_URL=
# Fremwork AI workspace that signed-in users are handed to. Default: https://app.fremwork.com
NEXT_PUBLIC_APP_URL=

# Optional overrides from a Vercel–Supabase integration; ignored when the canonical names above are set.
# NEXT_PUBLIC_FREMWORK_SUPABASE_URL=
# NEXT_PUBLIC_FREMWORK_SUPABASE_KEY=

# ─── 2. API (Vercel project, Root Directory: apps/api). Server-only values ──────────────────

# Same project as the website. Supabase → Project Settings → API → Project URL
FREMWORK_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…) or legacy service_role key.
# SERVER ONLY. Bypasses RLS. Set it only on the API project, never with a NEXT_PUBLIC_ prefix.
FREMWORK_SUPABASE_SECRET_KEY=
# Comma-separated site origins allowed to call the API (CORS); the first is used for invite links.
# e.g. https://fremwork.com,https://www.fremwork.com
WEB_URL=
# true = also allow any https://*.vercel.app origin. Leave false in production.
ALLOW_VERCEL_PREVIEWS=false
# resend.com → API Keys. Without it, emails are skipped and admin email sending reports "not configured".
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Fremwork Support <support@fremwork.com>
EMAIL_FROM=
# Local only: port for `pnpm dev:api`. Vercel ignores it.
PORT=4000
# Set to true only when self-hosting behind one reverse proxy (Vercel is detected automatically).
# TRUST_PROXY=false

# ─── 3. Supabase Edge Function secrets (Supabase → Edge Functions → Secrets) ────────────────
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
# RESEND_API_KEY=            required for registration-email and welcome-email
# EMAIL_FROM=                registration-email sender, default "Fremwork <events@fremwork.com>"
# WELCOME_EMAIL_FROM=        welcome-email sender, default "Fremwork <support@fremwork.com>"
# SITE_URL=                  logo/links base, default https://www.fremwork.com
# APP_URL=                   welcome email button, default https://fremai.vercel.app
# EVENT_TIMEZONE=            default Africa/Addis_Ababa
# EVENT_TZ_LABEL=            default EAT
