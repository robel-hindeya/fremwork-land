# Shared production Supabase project. For a local Supabase instance, replace both public settings together.
NEXT_PUBLIC_SUPABASE_URL=https://jwznteirgsnebvtswppu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_jSU3BbnNVHojq0teQR8j-A_3Au5k5k6

# NestJS API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical URL for SEO metadata (sign-in redirects use the current domain instead). Fremwork AI uses port 3000 locally,
# so run this site on 3001: pnpm --filter @fremwork/web exec next dev -p 3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Fremwork AI, where signed-in users are handed over. Defaults to https://app.fremwork.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional named overrides, if a Vercel integration supplies a different Supabase project.
NEXT_PUBLIC_FREMWORK_SUPABASE_URL=
NEXT_PUBLIC_FREMWORK_SUPABASE_KEY=
