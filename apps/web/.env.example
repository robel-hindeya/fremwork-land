# Supabase project (Dashboard → Project Settings → API). For local dev, `supabase status` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NestJS API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this site (used for auth redirects). Fremwork AI uses port 3000 locally,
# so run this site on 3001: pnpm --filter @fremwork/web exec next dev -p 3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Fremwork AI, where signed-in users are handed over. Defaults to https://fremai.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
