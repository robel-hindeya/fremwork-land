PORT=4000

# Supabase (Dashboard → Project Settings → API). Local: `supabase status`.
FREMWORK_SUPABASE_URL=https://jwznteirgsnebvtswppu.supabase.co
# Server only. Must belong to the project above; never expose this key to the browser.
FREMWORK_SUPABASE_SECRET_KEY=your-service-role-key

# Sites allowed to call the API (comma-separated, no trailing slash). Also used for invite links (first entry).
# Production example: WEB_URL=https://fremwork.com,https://fremwork-com.vercel.app
WEB_URL=http://localhost:3000
# true = also allow Vercel preview URLs (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false

# Resend Email (send emails from support@fremwork.com)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Fremwork Support <support@fremwork.com>
